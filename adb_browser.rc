/* adb_browser.rc - Windows resource script for AdbTools' main executable.
 *
 * This file exists mainly so the shipped binary carries the metadata Windows
 * and antimalware engines expect from a legitimate application:
 *
 *   * VS_VERSION_INFO  -> CompanyName / ProductName / FileDescription /
 *                         FileVersion / ProductVersion / OriginalFilename.
 *                         Windows shows these in the file-properties dialog and
 *                         reputation systems such as the Microsoft Intelligent
 *                         Security Graph use them to tell a real application
 *                         apart from an anonymous binary.
 *   * RT_MANIFEST      -> asInvoker / uiAccess=false, longPathAware.
 *                         Without an embedded manifest the OS may apply
 *                         installer-detection and UAC file-virtualization
 *                         heuristics, which look suspicious to AV engines.
 *
 * Values mirror kAppVersion in main.cpp and MyAppVersion in installer.iss.
 *
 * NOTE: numeric fields are written as plain decimals with named constants kept
 * to a minimum (e.g. FILEOS 0x40004 = VOS_NT_WINDOWS32, FILETYPE 1 = VFT_APP)
 * because windres' resource parser does not expand __MSABI_LONG() macros from
 * winver.h the way rc.exe does.
 */

#pragma code_page(65001)  /* this file is UTF-8 */

1 VERSIONINFO
FILEVERSION     0,9,8,0
PRODUCTVERSION  0,9,8,0
FILEFLAGSMASK   0x3f
FILEFLAGS       0x0
FILEOS          0x40004
FILETYPE        0x1
FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 040904b0 = US English, Unicode */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "joffeego"
            VALUE "FileDescription",  "ADB 文件浏览器 (AdbTools) - Android file manager and toolbox"
            VALUE "FileVersion",      "0.9.8.0"
            VALUE "InternalName",     "adb_browser"
            VALUE "LegalCopyright",   "Copyright (C) 2025 joffeego. Licensed under the Apache License 2.0."
            VALUE "OriginalFilename", "adb_browser.exe"
            VALUE "ProductName",      "ADB 文件浏览器 (AdbTools)"
            VALUE "ProductVersion",   "0.9.8"
            VALUE "Comments",         "Unofficial build? Set CompanyName/ProductName accordingly. https://github.com/joffeego/AdbTools"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* Application manifest: run with the caller's privileges (no elevation, no
 * UAC virtualization) and opt in to long-path support. DPI awareness is left
 * to the window backend, which sets per-monitor-v2 at startup. */
1 24 "adb_browser.manifest"

#pragma code_page(1252)
